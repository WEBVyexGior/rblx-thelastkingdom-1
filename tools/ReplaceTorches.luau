--[[
	ReplaceTorches — run in the Studio Command Bar of the FORGOTTEN LANDS place,
	in EDIT MODE. Select the whole file (Ctrl+A), copy, paste, Enter.

	Swaps every torch generated by BuildBattleground for your own model, and
	makes sure each one is actually ON a wall.

	IT DOES NOT JUST COPY MY POSITIONS. Mine were placed by arithmetic — offset
	from where a wall was supposed to be — and a few of them will be a stud out,
	or floating where a wall turned out to be ruined away. So each replacement
	CASTS RAYS outward, finds the real surface nearest to it, and sits flush
	against that: front facing out, back sunk exactly SINK studs in, so it never
	z-fights and never hovers.

	Any torch that cannot find a wall within reach is REPORTED, with its
	position, and not placed. A missing torch you know about is worth far more
	than a torch floating in mid-air that you find six weeks later.

	SETUP: put your torch model in the Workspace, named `TorchMID`. It stays
	where it is — the tool only ever clones it.

	IF THEY FACE THE WRONG WAY: set FACING_OFFSET below to 180 (or 90 / -90) and
	run it again. I cannot see which way your model was built.

	NOTE: a tool, not game code. Not synced by Rojo.
]]

--==========================================================================
-- Tune these
--==========================================================================
local TEMPLATE_NAME = "TorchMID"
local SINK = 0.02 -- how far the back edge goes into the wall
local SEARCH = 16 -- how far to look for a wall, in studs
local RAYS = 24 -- directions tried around the horizon
local FACING_OFFSET = 0 -- degrees, if your model faces the wrong way
local RISE = 0 -- nudge every torch up or down, if they sit low

-- Lights are the expensive part. The nearest ones to the route keep theirs;
-- the rest keep the look and lose the cost.
local MAX_LIT = 60

--==========================================================================
local template = workspace:FindFirstChild(TEMPLATE_NAME)
if not template then
	warn(("[Torches] no `%s` in the Workspace. Put your torch model there, named exactly that, and run again."):format(TEMPLATE_NAME))
	return
end
if not template:IsA("Model") and not template:IsA("BasePart") then
	warn("[Torches] `" .. TEMPLATE_NAME .. "` must be a Model or a Part.")
	return
end

local ground = workspace:FindFirstChild("Gameplay")
if not ground then
	warn("[Torches] no Workspace.Gameplay — build the battleground first.")
	return
end

--==========================================================================
-- Find every torch the builder made
--==========================================================================
local existing = {}
for _, descendant in ipairs(ground:GetDescendants()) do
	if descendant.Name == "Torch" and descendant:IsA("Model") then
		table.insert(existing, descendant)
	end
end

if #existing == 0 then
	warn("[Torches] found none to replace. Has BuildBattleground been run?")
	return
end
print(("[Torches] found %d to replace"):format(#existing))

--==========================================================================
-- Geometry of the template
--==========================================================================
local _templateCFrame, templateSize
if template:IsA("Model") then
	_templateCFrame, templateSize = template:GetBoundingBox()
else
	_templateCFrame, templateSize = template.CFrame, template.Size
end
-- How deep the model is along the direction it faces. The back of that depth is
-- what has to meet the wall.
local halfDepth = templateSize.Z / 2

--==========================================================================
-- Rays ignore every torch, old and new, and the template itself
--==========================================================================
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local ignore = { template }
for _, torch in ipairs(existing) do
	table.insert(ignore, torch)
end
params.FilterDescendantsInstances = ignore

--[[
	Finds the nearest solid surface around a point.

	Tries the horizon first and slightly downward second: a torch belongs on a
	vertical face, and casting only horizontally misses the underside of an arch
	or a machicolation, which are exactly where a torch looks best.
]]
local function nearestSurface(origin: Vector3)
	local best, bestDistance = nil, math.huge

	for pitch = 0, 1 do
		local lift = if pitch == 0 then 0 else -0.35
		for i = 0, RAYS - 1 do
			local a = (math.pi * 2 / RAYS) * i
			local direction = Vector3.new(math.cos(a), lift, math.sin(a)).Unit * SEARCH
			local hit = workspace:Raycast(origin, direction, params)
			if hit then
				local distance = (hit.Position - origin).Magnitude
				if distance < bestDistance then
					best, bestDistance = hit, distance
				end
			end
		end
		if best then
			break -- the horizon found something; no need to look down
		end
	end

	return best
end

--==========================================================================
-- Replace
--==========================================================================
local placed, failed = 0, 0
local orphans = {}

for _, old in ipairs(existing) do
	local origin = old:GetPivot().Position
	local hit = nearestSurface(origin)

	if not hit then
		failed += 1
		table.insert(orphans, origin)
	else
		local normal = hit.Normal
		-- Flat against the face: sitting on the surface, sunk by SINK so the two
		-- never z-fight, and never floating.
		local seat = hit.Position + normal * (halfDepth - SINK) + Vector3.new(0, RISE, 0)

		local clone = template:Clone()
		clone.Name = "Torch"

		-- LookVector points away from the wall, so the flame is out in the room.
		local facing = CFrame.lookAt(seat, seat + normal) * CFrame.Angles(0, math.rad(FACING_OFFSET), 0)

		if clone:IsA("Model") then
			clone:PivotTo(facing)
			for _, part in ipairs(clone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored = true
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
				end
			end
		else
			clone.CFrame = facing
			clone.Anchored = true
			clone.CanCollide = false
		end

		-- Past the cap, keep the torch and drop the light.
		if placed >= MAX_LIT then
			for _, item in ipairs(clone:GetDescendants()) do
				if item:IsA("Light") then
					item.Enabled = false
				end
			end
		end

		clone.Parent = old.Parent
		placed += 1
	end

	old:Destroy()
end

--==========================================================================
print(("[Torches] placed %d, all flush to a wall (%d keeping their light)"):format(placed, math.min(placed, MAX_LIT)))

if failed > 0 then
	warn(("[Torches] %d could NOT find a wall within %d studs and were NOT placed:"):format(failed, SEARCH))
	for _, at in ipairs(orphans) do
		warn(("    (%d, %d, %d)"):format(at.X, at.Y, at.Z))
	end
	warn("[Torches] Those spots have no wall near them — most likely a ruined section. Raise SEARCH, or place those few by hand.")
end

print("[Torches] Facing wrong? Set FACING_OFFSET to 180 (or 90 / -90) and run again.")
print("[Torches] Sitting too low or high? Nudge RISE.")
